# Variables de entorno del servidor Electravelin
# Copiar como .env y completar valores

PORT=3001

# Firma de los JWT propios. Obligatorio en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Cuenta administradora inicial (opcional). Si se define y no existe, se crea
# al arrancar el servidor con rol admin. No versionar estos valores.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Orígenes permitidos por CORS, separados por coma. Si se omite, se permite
# cualquier origen (solo recomendado en desarrollo).
# CLIENT_ORIGIN=https://electravelin-web.onrender.com,http://localhost:5173
CLIENT_ORIGIN=

# Ruta del archivo de datos local (usuarios, viajes, favoritos, auditoría y
# catálogo editable). Por defecto server/data/electravelin.json.
DATA_FILE=

# Nivel de logging: debug | info | warn | error
LOG_LEVEL=info

# OpenRouteService: clave privada usada exclusivamente por el backend.
# Obtenerla en https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Opcionales: permiten usar proxies o identificar la aplicación ante Nominatim.
ORS_BASE_URL=https://api.openrouteservice.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Electravelin/2.0 (contacto@electravelin.cl)
